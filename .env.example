# ============================================
# 📋 Environment variables template
# ============================================
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and overrides other .env files.
#
# Vite exposes only VITE_* variables to client code.
# Never put secrets (API keys, tokens) in VITE_* variables!

VITE_APP_ENV=development
VITE_APP_NAME="Zawody.pl (DEV)"
VITE_API_URL=http://localhost:8081/api/v1
VITE_ENABLE_MOCKS=true
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=debug

# --- Optional overrides ---
# VITE_GOOGLE_CALENDAR_API_URL=
# VITE_SENTRY_DSN=
# VITE_GA_TRACKING_ID=
# VITE_STRIPE_PUBLIC_KEY=

# Set to "true" to show the DevToolbox outside a dev build (staging).
# VITE_ENABLE_DEV_TOOLS=false

# Search engine indexing. Default (unset) = blocked: noindex meta + robots.txt "Disallow: /".
# Set to "true" ONLY for the production build (deploy.yml does this).
# VITE_ALLOW_INDEXING
