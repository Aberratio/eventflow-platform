# ============================================
# 🔵 Dev environment (hosted test instance)
# ============================================
# Used by: npm run dev:dev, npm run build:dev
# Not the same as local: for a backend on your machine use npm run dev
# (.env.development).

VITE_APP_ENV=dev
VITE_APP_NAME="Zawody.pl (DEV)"
VITE_API_URL=https://portal-api-dev.zmierzymyczas.kokot.it/api/v1
VITE_ENABLE_MOCKS=false
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=debug

# DevToolbox (seed-event generator). The dev API requires a live
# organizer/staff session for it, same as staging.
VITE_ENABLE_DEV_TOOLS=true
