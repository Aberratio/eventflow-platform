# ============================================
# 🔧 Local environment (backend on this machine)
# ============================================
# Used by: npm run dev, npm run build:local
# The hosted dev instance has its own file: .env.dev (npm run dev:dev).

VITE_APP_ENV=development
VITE_APP_NAME="Zawody.pl (LOCAL)"
VITE_API_URL=http://localhost:8081/api/v1
VITE_ENABLE_MOCKS=false
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=debug
